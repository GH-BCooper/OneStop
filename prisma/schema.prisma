// OneStop database schema (13-auth-database.md; master plan §16).
//
// Kept deliberately small: the four business tables from §16 plus the three tables Auth.js
// needs for OAuth and password reset. No file binaries are ever stored here - only metadata.
generator client {
  provider   = "prisma-client"
  output     = "../apps/api/src/db/generated"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// master plan §16. `passwordHash` is null for accounts created through Google only.
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  avatar        String?
  birthday      DateTime?
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts            Account[]
  sessions            Session[]
  jobs                Job[]
  workflows           Workflow[]
  settings            UserSettings?
  passwordResetTokens PasswordResetToken[]
  favorites           Favorite[]
  qrLinks             QrLink[]
  emailChangeRequest  EmailChangeRequest?
  accountDeleteOtp    AccountDeleteOtp?

  @@map("users")
}

/// Auth.js: one row per linked OAuth provider account.
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js: only used when the session strategy is "database". Kept so the Prisma adapter's
/// full surface type-checks; OneStop signs sessions as JWTs so this table normally stays empty.
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js: email-verification / magic-link tokens. Unused today, required by the adapter.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Single-use password reset token. Only the SHA-256 hash of the token is stored, so a database
/// leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A sign-up that is waiting for its emailed code. The account (a `User` row) is created only when
/// the code is entered correctly, so an address nobody controls can never become an account. The
/// code is stored as an HMAC, never in clear; the password is already a bcrypt hash.
model SignupOtp {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("signup_otps")
}

/// A pending email change (17-... account settings). Changing the address proves control of both
/// the old mailbox (so an attacker who merely stole a session cannot silently move the account to
/// an address they own) and the new one (so a typo can never lock the account out). The email only
/// changes once both codes have been entered; either code is an HMAC, never stored in clear.
model EmailChangeRequest {
  id                String    @id @default(uuid())
  userId            String    @unique
  newEmail          String
  currentCodeHash   String
  currentVerifiedAt DateTime?
  newCodeHash       String?
  attempts          Int       @default(0)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_change_requests")
}

/// A pending account deletion. One click is not enough to destroy an account, so deleting requires
/// the same emailed-code proof of mailbox ownership as changing the email.
model AccountDeleteOtp {
  id        String   @id @default(uuid())
  userId    String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_delete_otps")
}

/// master plan §16. `userId` is null for guest jobs.
model Job {
  id             String   @id @default(uuid())
  userId         String?
  toolId         String
  status         String
  inputMetadata  Json     @default("{}")
  outputMetadata Json?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("jobs")
}

/// master plan §16. The run engine arrives in phase 15; this phase only creates the table.
model Workflow {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  steps       Json     @default("[]")
  favorite    Boolean  @default(false)
  useCount    Int      @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflows")
}

/// master plan §16: theme, preferred AI runtime and other small preferences.
model UserSettings {
  userId      String   @id
  theme       String   @default("system")
  preferredAI String?
  preferences Json     @default("{}")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// A tool the user starred (14-history-favorites.md). `toolId` is a registry id; the registry is
/// the source of truth for what that id means, so nothing here duplicates a tool's metadata.
model Favorite {
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// A dynamic QR code (14-history-favorites.md), moved out of phase 11's interim JSON file.
/// `userId` is null for a code made by a guest or before accounts existed - it still resolves.
model QrLink {
  id            String    @id
  userId        String?
  kind          String
  title         String
  target        String?
  page          Json?
  active        Boolean   @default(true)
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  /// Every destination this code has had, oldest first, as { at, target }.
  history       Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  scans QrScan[]

  @@index([userId, createdAt])
  @@map("qr_links")
}

/// One scan of a dynamic QR code. Coarse hints only: never an IP address (master plan §15).
model QrScan {
  id       String   @id @default(uuid())
  linkId   String
  at       DateTime @default(now())
  device   String?
  referrer String?

  link QrLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, at])
  @@map("qr_scans")
}
