# ---------------------------------------------------------------------------
# OneStop environment variables
# Copy to `.env` (never commit `.env`). Every variable is documented below.
# Nothing here requires a paid service. The app boots in dev with this file
# copied as-is; features that need a missing value degrade gracefully.
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test. Optional (Next.js sets it automatically).
NODE_ENV=development

# Public base URL of the app, used for absolute links and OAuth callbacks. Optional in dev, REQUIRED in hosted mode.
# Dynamic QR codes (phase 11) encode `<APP_URL>/q/<id>`, so a printed code is only as portable as
# this value: set it to the real public URL *before* making codes you intend to print.
APP_URL=http://localhost:3000

# PostgreSQL connection string (Prisma). Needed for accounts, saved history and durable job
# records (phase 13). Leave it unset and the app still runs: every tool works, jobs are kept in
# memory only, and the account pages say accounts are switched off.
# Local: `docker compose up -d` matches this value, then `npm run db:deploy` creates the tables.
# Hosted: any free-tier Postgres (Neon, Supabase, Railway).
DATABASE_URL=postgresql://onestop:onestop@localhost:5432/onestop?schema=public

# Database used by the integration tests. Optional: the database-backed tests skip themselves when
# neither this nor DATABASE_URL is set. Point it at a THROWAWAY database - each test file creates
# and drops its own schema inside it.
TEST_DATABASE_URL=

# Host port for the optional docker-compose Postgres. Optional: default 5432; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432

# Auth.js secret for signing session cookies. Required for signing in (with DATABASE_URL); without
# it the account pages say accounts are switched off. AUTH_SECRET is read first if both are set.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Auth.js canonical URL. Optional locally; REQUIRED in hosted mode (usually same as APP_URL).
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client ID (Google Cloud Console, free). Optional: Google sign-in is hidden if unset.
GOOGLE_CLIENT_ID=

# Google OAuth client secret. Optional: required only together with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# Python interpreter used by the Node<->Python bridge. Optional: defaults to `python3` (`python` on Windows).
PYTHON_PATH=

# FFmpeg binary for the audio/video tools (phase 10). Optional: found on PATH or in the usual install
# folders. FFmpeg is required for those tools; without it they all report the same setup message.
# See the README's "FFmpeg" section for install commands.
FFMPEG_PATH=

# ffprobe binary. Optional: looked for next to FFmpeg first, then on PATH. Set it only if the two
# binaries live in different folders.
FFPROBE_PATH=

# How long an audio/video tool may run before it is cancelled, in seconds. Optional: defaults to 600
# (10 minutes), capped at 3600. Other tools keep the 120 s limit.
MEDIA_TIMEOUT_SECONDS=

# LibreOffice `soffice` binary for high-fidelity Office <-> PDF conversion (phases 06-08). Optional:
# found on PATH or in the default install folder; without it a built-in converter is used and the
# result says fidelity may be lower. Formats only LibreOffice reads (.doc, .xls, .ppt, OpenDocument) then
# show an "install LibreOffice" message instead.
LIBREOFFICE_PATH=

# Folder containing Tesseract `<lang>.traineddata.gz` files for OCR PDF (phase 06). Optional: the
# English model ships with `npm install` (@tesseract.js-data/eng), so OCR works offline out of the box.
OCR_LANG_PATH=

# yt-dlp binary for online media tools (phase 17). Optional: defaults to `yt-dlp` on PATH.
YTDLP_PATH=

# Directory for temporary uploads/outputs. Optional: defaults to the OS temp dir; OneStop uses an
# `onestop-temp` subfolder inside it, creates it on demand and clears leftovers at startup.
TEMP_DIR=

# Where the interim dynamic-QR store lives (phase 11: destinations, hosted pages and scan counts).
# Optional: defaults to `.onestop-data` beside the running app (apps/web when started with `npm start`).
# Unlike TEMP_DIR this data is not swept - a dynamic code has to outlive the tab that made it.
# Phase 14 moves it into Postgres, after which this variable goes away.
QR_DATA_DIR=

# Minutes before temporary files are auto-deleted. Optional: default 60. Inputs are deleted as soon
# as a job finishes (success or failure); results live until downloaded or until this window ends.
TEMP_FILE_TTL_MINUTES=60

# Maximum size of a single upload, in megabytes. Optional: default 100. One request may carry up to
# four times this in total, across at most 50 files.
MAX_UPLOAD_MB=100

# Ollama server for the fully local/offline AI assistant (phase 16). Optional: AI features show a clear "not available" message if unreachable.
OLLAMA_HOST=http://localhost:11434

# Default Ollama model name (phase 16). Optional.
OLLAMA_MODEL=llama3.2

# Free-tier hosted AI keys (phase 16). All optional and opt-in; they send data off-device, which the UI discloses.
# Groq API key (free tier). Optional.
GROQ_API_KEY=
# OpenRouter API key (free models). Optional.
OPENROUTER_API_KEY=
# Google AI Studio API key (free tier). Optional.
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Password-reset email (phase 13). All optional: with none of these set, the reset link is written
# to the server console, which is the local/offline default and costs nothing.
# ---------------------------------------------------------------------------

# Force a transport: console | resend | smtp. Optional: otherwise the first configured one wins.
MAIL_TRANSPORT=

# Resend API key (free tier, https://resend.com). Optional: enables real email with no SMTP server.
RESEND_API_KEY=

# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587. Optional; needs the optional
# `nodemailer` package installed (npm install nodemailer).
SMTP_URL=

# From address for reset emails. Optional: defaults to OneStop <onboarding@resend.dev>.
MAIL_FROM=
